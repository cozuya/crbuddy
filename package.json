{
  "name": "crbuddy",
  "version": "0.3.0",
  "description": "Fan one code review out across several vendor coding agents in parallel, then consolidate.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozuya/crbuddy.git"
  },
  "homepage": "https://github.com/cozuya/crbuddy#readme",
  "bugs": {
    "url": "https://github.com/cozuya/crbuddy/issues"
  },
  "author": "Chris Ozols <chris.v.ozols@gmail.com>",
  "type": "module",
  "bin": {
    "crbuddy": "dist/index.js",
    "crb": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "scripts/postinstall.mjs",
    "README.md",
    "GUIDE.md",
    "DESIGN.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "npm run build",
    "test": "npm run build:test && node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "keywords": [
    "code-review",
    "cli",
    "multi-agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "@types/cross-spawn": "^6.0.6"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cross-spawn": "^7.0.6"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
