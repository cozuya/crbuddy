+  diff: '',
+  digest: 'e3b0c442',
+  files: [],
+  bytes: 0,
+};
+
+const instructions =
+  'Review this repository as it currently stands. There is no diff to review.';
+
+const run: RunRecord = {
+  id: 'claude-opus',
+  vendor: 'claude',
+  cli: 'claude',
+  cliVersion: '2.0.0',
+  modelRequested: 'opus',
+  effortRequested: null,
