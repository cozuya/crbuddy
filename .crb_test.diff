+    const invocation = adapter.build({
+      operation: { kind: 'generic', target: null, instructions },
+      model: 'a-model',
+      repoRoot: '/repo',
+      supports,
+    });
+
+    assert.equal(invocation.command, adapter.command);
+  }
+});
