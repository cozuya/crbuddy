{
  "configVersion": 1,
  "output": {
    "merged": "CODE-REVIEW-HANDOFF.md"
  },
  "target": "uncommitted",
  "refuseIfOutputExists": false,
  "timeoutMs": 3600000,
  "maxConcurrent": 0,
  "maxDiffBytes": 2000000,
  "panel": [
    { "vendor": "claude", "model": "opus", "effort": "max" },
    { "vendor": "codex", "model": "gpt-6-sol", "effort": "xhigh" },
    {
      "vendor": "gemini",
      "model": "gemini-3.1-pro-preview",
      "instructions": "Review the changes for correctness, regressions, and missing tests."
    },
    {
      "id": "security",
      "vendor": "claude",
      "model": "sonnet",
      "effort": "high",
      "instructions": "Review only for security issues: injection, authorization gaps, secrets handling, unsafe deserialization."
    }
  ]
}
